# OPDA / PDTF sandbox — configuration TEMPLATE.
# Copy this to ~/.opda-sandbox/config.env and fill in YOUR values:
#     mkdir -p ~/.opda-sandbox
#     cp config.example.env ~/.opda-sandbox/config.env
# Keeping it in ~/.opda-sandbox/ means it survives plugin updates and sits with
# your certs. NEVER share or commit config.env or your key files.

# Folder holding your mTLS transport cert + private key (issued by the sandbox CA).
OPDA_CERT_DIR="$HOME/.opda-sandbox"
TRANSPORT_CERT="transport.pem"
TRANSPORT_KEY="transport.key"

# Your Relying Party client_id — MUST be the FULL URL, not the bare UUID.
# Find it in the Raidiam directory under your Application. It looks like:
#   https://rp.directory.pdtf.raidiam.io/openid_relying_party/<your-app-uuid>
CLIENT_ID="https://rp.directory.pdtf.raidiam.io/openid_relying_party/REPLACE-WITH-YOUR-APP-UUID"

# Your organisation id from the directory (optional, handy for org-scoped calls).
ORG_ID="REPLACE-WITH-YOUR-ORG-UUID"

# Sandbox hosts — leave as-is unless OPDA tells you otherwise.
TOKEN_URL="https://matls-auth.directory.pdtf.raidiam.io/token"
DIR_API="https://matls-api.directory.pdtf.raidiam.io"

# Scope requested when a script isn't given one.
DEFAULT_SCOPE="directory:software"
